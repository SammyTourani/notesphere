# ====================================
# 🔥 FIREBASE CONFIGURATION
# ====================================
# Get these values from your Firebase Console:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ====================================
# 🤖 AI SERVICES (Future Integration)
# ====================================
# These will be needed when you replace the grammar engine with AI

# OpenAI API Key (for GPT-4/GPT-3.5 grammar checking)
# Get from: https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude grammar checking)
# Get from: https://console.anthropic.com/account/keys
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key (for Gemini grammar checking)
# Get from: https://makersuite.google.com/app/apikey
# VITE_GOOGLE_AI_API_KEY=...

# ====================================
# 📝 LANGUAGETOOL API (Current System)
# ====================================
# Current grammar system uses LanguageTool (can be self-hosted or public API)
# Public API: https://languagetool.org/http-api/
# Self-hosted: https://languagetool.org/http-server/

# VITE_LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check
# VITE_LANGUAGETOOL_API_KEY=... (optional, for premium features)

# ====================================
# 🚀 DEPLOYMENT
# ====================================
# VITE_APP_URL=https://your-app-domain.com
