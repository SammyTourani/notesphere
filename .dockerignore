# .dockerignore
# Prevents unnecessary files from being copied into Docker image

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.vite/
.cache/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Documentation
README.md
CHANGELOG.md
LICENSE
*.md
!package.md

# Test files
**/*.test.js
**/*.spec.js
**/*.test.jsx
**/*.spec.jsx
coverage/
.nyc_output/
jest.config.js

# Misc
.dockerignore
Dockerfile
docker-compose.yml
.editorconfig
.eslintrc*
.prettierrc*

# Benchmark and test files
mega-engine*.json
mega-engine*.html
mega-engine*.js
test-*.html
*-test.html
*BENCHMARK*.md
*REPORT*.md
*ROADMAP*.md
